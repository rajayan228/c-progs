#include <iostream>
using namespace std;
int main() {
	int n,i,ar[10];
	int positive=0,negative=0,zero=0;
	for(i=0;i<10;i++){
	 cin>>ar[i];
	 if(ar[i]==0)
	   zero=zero+1;
	 else if(ar[i]>0)
	   positive=positive+1;
	 else if(ar[i]<0)
	   negative=negative+1;
	 
	}
	cout<<"zero="<<zero<<" positive="<<positive<<" negative="<<negative<<endl;
	return 0;

}
