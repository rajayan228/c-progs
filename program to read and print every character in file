// Online C++ compiler to run C++ program online
#include <iostream>
# include <fstream>
using namespace std;
int main() {
    ifstream fin("story.txt");
    if(!fin){
    
        cout<<"error:file doesnot exist"<<endl;
        return 0;
    }
    char ch;
    while(fin.get(ch)){
        cout<<ch;
    }
    fin.close();
    

    return 0;
}
