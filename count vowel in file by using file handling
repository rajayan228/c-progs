#include <iostream>
#include<fstream>
using namespace std;
int main(){
    ifstream fin("story.txt");
    if(!fin){
        cout<<"file does not exist"<<endl;
    }
    int vowels=0;
    char ch;
    while(fin.get(ch))
    {
        if(ch=='a'||ch=='e'||ch=='i'||ch=='o'||ch=='u'||ch=='A'||ch=='E'||ch=='I'||ch=='O'||ch=='U'){
            vowels++;
        }
    }
    cout<<"count of vowels"<<vowels<<endl;


    return 0;
}
